# ---- Required to run anything (the AI brain) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-5

# ---- Database ----
# Absolute path to the SQLite file. On Render, this MUST point inside a
# mounted persistent Disk (e.g. /var/data/concierge.sqlite) — otherwise every
# deploy or restart wipes all bookings, conversations, and flags. Leave
# blank for local development, where it defaults to a file in the project.
DB_PATH=

# ---- Server ----
PORT=3000
# Public URL of this server once deployed or tunneled (e.g. via ngrok).
# Used to build the demo payment link and Stripe redirect URLs.
BASE_URL=http://localhost:3000

# ---- Twilio (leave blank to run in console-log demo mode) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Stripe (leave blank to run in demo payment-link mode) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key (starts with pk_...), NOT the secret key — this one is
# safe to expose in the browser. Grab it from the same API keys page as
# STRIPE_SECRET_KEY. Required for the embedded checkout page to load.
STRIPE_PUBLISHABLE_KEY=

# ---- Resend (leave blank to run in console-log demo mode) ----
# Powers the booking-confirmation email option (see "Demo polish" in
# docs/audits/aurum-hardening-report.md) — a guest who chooses email over
# text on the web widget gets their confirmation from here.
RESEND_API_KEY=
EMAIL_FROM=

# ---- Guest-facing SMS confirmations ----
# Off by default. Set to "true" only once the venue's Twilio campaign
# registration covers guest-facing confirmation texts (not the existing
# staff-facing inbound SMS concierge line, which is unaffected by this).
# While false, the web widget never offers or mentions texting a
# confirmation at all — email is the only option shown. See "Demo polish"
# in docs/audits/aurum-hardening-report.md.
WEB_SMS_OPT_IN=false

# ---- Venue config ----
VENUE_NAME=The Velvet Room
MAX_TABLES_PER_TIER_PER_NIGHT=3
# Optional: full URL to a bottle-service / VIP menu page on the venue's
# website. When set, the bot links guests to it instead of trying to
# describe bottle pricing itself. Leave blank if there's no menu page yet.
MENU_URL=

# ---- Admin console ----
# Password for the /admin dashboard (bookings, conversations, flagged
# follow-ups, venue settings). Required — /admin refuses all access until
# this is set to a real value. Pick something you wouldn't mind a guest
# guessing badly at; this is a shared password, not a per-user login.
ADMIN_PASSWORD=

# ---- Cost/abuse guards (public demo) ----
# This instance is embedded on a public marketing site, not behind a
# login — see docs/audits/aurum-hardening-report.md. Global daily cap on
# real Anthropic API calls, across every conversation combined. Once hit,
# every further reply for the rest of the day is a fixed "the demo is
# resting" message with zero model calls. 2000 is a generous default;
# lower it if the real bill ever needs a tighter ceiling.
DEMO_DAILY_MODEL_CALLS=2000
