# ---- Required to run anything (the AI brain) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-5

# ---- Server ----
PORT=3000
# Public URL of this server once deployed or tunneled (e.g. via ngrok).
# Used to build the demo payment link and Stripe redirect URLs.
BASE_URL=http://localhost:3000

# ---- Twilio (leave blank to run in console-log demo mode) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Stripe (leave blank to run in demo payment-link mode) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Venue config ----
VENUE_NAME=The Velvet Room
MAX_TABLES_PER_TIER_PER_NIGHT=3
# Optional: full URL to a bottle-service / VIP menu page on the venue's
# website. When set, the bot links guests to it instead of trying to
# describe bottle pricing itself. Leave blank if there's no menu page yet.
MENU_URL=

# ---- Admin console ----
# Password for the /admin dashboard (bookings, conversations, flagged
# follow-ups, venue settings). Required — /admin refuses all access until
# this is set to a real value. Pick something you wouldn't mind a guest
# guessing badly at; this is a shared password, not a per-user login.
ADMIN_PASSWORD=
